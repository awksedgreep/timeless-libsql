{
  "schema_version": 1,
  "oracle": "victoriametrics-v1.148.0",
  "cases": [
    {
      "id": "MQL-09-direct-window-one-second-step",
      "query": "count_over_time(oracle_step[5i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 4000, "step": "1s"},
      "expected_metric": {"job": "oracle"},
      "expected_values": [5, 5, 5, 5, 5]
    },
    {
      "id": "MQL-09-direct-window-two-second-step",
      "query": "count_over_time(oracle_step[5i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 4000, "step": "2s"},
      "expected_metric": {"job": "oracle"},
      "expected_values": [10, 10, 10]
    },
    {
      "id": "MQL-09-subquery-window-and-resolution",
      "query": "max_over_time(vector(time())[5i:1i]) - min_over_time(vector(time())[5i:1i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 4000, "step": "2s"},
      "expected_values": [8, 8, 8]
    },
    {
      "id": "MQL-09-millisecond-step",
      "query": "max_over_time(vector(time())[5i:1i]) - min_over_time(vector(time())[5i:1i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 3000, "step": "1500ms"},
      "expected_values": [6, 6, 6]
    },
    {
      "id": "MQL-09-zero-step-relative-window",
      "query": "count_over_time(vector(time())[0i:1i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 2000, "step": "1s"},
      "expected_values": [1, 1, 1]
    }
  ],
  "operator_cases": [
    {
      "id": "MQL-01-default-fills-filtered-and-missing-grid-points",
      "query": "(oracle_mql_cpu > 2) default 0",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [0, 0, 3]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "values": [0, 0, 4]
        }
      ]
    },
    {
      "id": "MQL-01-default-preserves-completely-filtered-series-identity",
      "query": "(oracle_mql_cpu > 5) default 0",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [0, 0, 0]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "values": [0, 0, 0]
        }
      ]
    },
    {
      "id": "MQL-01-default-matches-vectors-on-explicit-labels",
      "query": "(oracle_mql_cpu > 2) default on(host) oracle_mql_sparse",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [10, 10, 3]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "offsets_ms": [20000, 30000],
          "values": [20, 4]
        }
      ]
    },
    {
      "id": "MQL-01-default-preserves-vector-comparison-identities",
      "query": "(oracle_mql_cpu > on(host) oracle_mql_sparse) default 0",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {"metric": {"host": "a"}, "values": [0, 0, 0]},
        {"metric": {"host": "b"}, "values": [0, 0, 0]}
      ]
    },
    {
      "id": "MQL-01-default-preserves-vector-identity-without-overlapping-samples",
      "query": "(oracle_mql_disjoint_left > on(host) oracle_mql_disjoint_right) default 0",
      "evaluation_offset_ms": 610000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 610000, "step": "600s"},
      "expected_results": [
        {"metric": {"host": "c"}, "values": [0, 0]}
      ]
    },
    {
      "id": "MQL-01-if-keeps-left-values-only-where-right-exists",
      "query": "oracle_mql_cpu if on(host) oracle_mql_sparse",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [1, 1, 3]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "offsets_ms": [20000, 30000],
          "values": [2, 4]
        }
      ]
    },
    {
      "id": "MQL-01-set-join-modifier-does-not-rewrite-left-labels",
      "query": "oracle_mql_cpu if on(host) group_left(zone) oracle_mql_sparse",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [1, 1, 3]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "offsets_ms": [20000, 30000],
          "values": [2, 4]
        }
      ]
    },
    {
      "id": "MQL-01-ifnot-keeps-unmatched-left-series",
      "query": "oracle_mql_cpu ifnot oracle_mql_sparse",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [1, 1, 3]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "offsets_ms": [20000, 30000],
          "values": [2, 4]
        }
      ]
    },
    {
      "id": "MQL-01-default-composes-under-aggregation",
      "query": "sum((oracle_mql_cpu > 2) default 0)",
      "evaluation_offset_ms": 30000,
      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {"metric": {}, "values": [0, 0, 7]}
      ]
    },
    {
      "id": "MQL-01-scalars-are-nameless-vectors",
      "query": "1 default 2",
      "evaluation_offset_ms": 30000,
      "expected_metric": {},
      "expected_values": [1]
    },
    {
      "id": "MQL-02-transform-retains-each-input-metric-name",
      "query": "abs({__name__=~\"oracle_keep_a|oracle_keep_b\"}) keep_metric_names",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 3
        }
      ]
    },
    {
      "id": "MQL-02-rollup-retains-the-source-metric-name",
      "query": "rate(oracle_step[5s]) keep_metric_names",
      "evaluation_offset_ms": 20000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_step", "job": "oracle"},
          "value": 1
        }
      ]
    },
    {
      "id": "MQL-02-scalar-binary-retains-each-input-metric-name",
      "query": "({__name__=~\"oracle_keep_a|oracle_keep_b\"} / 10) keep_metric_names",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 0.2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 0.3
        }
      ]
    },
    {
      "id": "MQL-02-vector-binary-matches-on-metric-name",
      "query": "(oracle_keep_a + oracle_keep_b) keep_metric_names",
      "evaluation_offset_ms": 30000,
      "expected_results": []
    },
    {
      "id": "MQL-02-explicit-on-still-matches-on-metric-name",
      "query": "(oracle_keep_a + on(host) oracle_keep_b) keep_metric_names",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared"},
          "value": 5
        }
      ]
    },
    {
      "id": "MQL-02-nested-transform-keeps-identities-until-aggregation",
      "query": "sum(abs({__name__=~\"oracle_keep_a|oracle_keep_b\"}) keep_metric_names)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {"metric": {}, "value": 5}
      ]
    },
    {
      "id": "MQL-03-named-union-preserves-distinct-labelsets",
      "query": "union(oracle_keep_a, oracle_keep_b)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 3
        }
      ]
    },
    {
      "id": "MQL-03-parenthesized-union-is-equivalent",
      "query": "(oracle_keep_a, oracle_keep_b)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 3
        }
      ]
    },
    {
      "id": "MQL-03-alias-renames-the-metric",
      "query": "alias(oracle_keep_a, \"oracle_alias\")",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_alias", "host": "shared", "job": "oracle"},
          "value": 2
        }
      ]
    },
    {
      "id": "MQL-03-first-union-argument-wins-alias-collision",
      "query": "union(alias(oracle_keep_a, \"oracle_alias_collision\"), alias(oracle_keep_b, \"oracle_alias_collision\"))",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_alias_collision", "host": "shared", "job": "oracle"},
          "value": 2
        }
      ]
    },
    {
      "id": "MQL-03-empty-alias-removes-the-metric-name",
      "query": "alias(oracle_keep_a, \"\")",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"host": "shared", "job": "oracle"},
          "value": 2
        }
      ]
    },
    {
      "id": "MQL-03-union-and-alias-compose-under-aggregation",
      "query": "sum(union(alias(oracle_keep_a, \"oracle_alias_a\"), alias(oracle_keep_b, \"oracle_alias_b\")))",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {"metric": {}, "value": 5}
      ]
    },
    {
      "id": "MQL-03-zero-argument-union-is-empty",
      "query": "union()",
      "evaluation_offset_ms": 30000,
      "expected_results": []
    },
    {
      "id": "MQL-03-single-argument-union-is-identity",
      "query": "union(oracle_keep_a)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        }
      ]
    },
    {
      "id": "MQL-03-named-union-allows-a-trailing-comma",
      "query": "union(oracle_keep_a, oracle_keep_b,)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 3
        }
      ]
    },
    {
      "id": "MQL-03-parenthesized-union-allows-a-trailing-comma",
      "query": "(oracle_keep_a, oracle_keep_b,)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 3
        }
      ]
    },
    {
      "id": "MQL-03-single-parenthesized-expression-allows-a-trailing-comma",
      "query": "(oracle_keep_a,)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        }
      ]
    },
    {
      "id": "MQL-03-alias-allows-a-trailing-comma",
      "query": "alias(oracle_keep_a, \"oracle_alias\",)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_alias", "host": "shared", "job": "oracle"},
          "value": 2
        }
      ]
    },
    {
      "id": "MQL-03-union-function-name-is-case-insensitive",
      "query": "UNION(oracle_keep_a, oracle_keep_b)",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {
          "metric": {"__name__": "oracle_keep_a", "host": "shared", "job": "oracle"},
          "value": 2
        },
        {
          "metric": {"__name__": "oracle_keep_b", "host": "shared", "job": "oracle"},
          "value": 3
        }
      ]
    }
  ],
  "operator_error_cases": [
    {
      "id": "MQL-01-incomplete-default-fails",
      "query": "oracle_mql_cpu default",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "singleExpr: unexpected token"
    },
    {
      "id": "MQL-01-unclosed-matching-modifier-fails",
      "query": "oracle_mql_cpu default on(host",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "ModifierExpr: identList"
    },
    {
      "id": "MQL-01-bool-modifier-is-invalid",
      "query": "oracle_mql_cpu default bool 0",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "bool modifier cannot be applied to"
    },
    {
      "id": "MQL-02-bare-selector-rejects-modifier",
      "query": "oracle_keep_a keep_metric_names",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "unparsed data left"
    },
    {
      "id": "MQL-02-aggregation-rejects-modifier",
      "query": "sum(oracle_keep_a) keep_metric_names",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "unparsed data left"
    },
    {
      "id": "MQL-02-unary-rejects-modifier",
      "query": "-oracle_keep_a keep_metric_names",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "unparsed data left"
    },
    {
      "id": "MQL-03-alias-rejects-a-post-rename-labelset-collision",
      "query": "alias({__name__=~\"oracle_keep_a|oracle_keep_b\"}, \"oracle_alias_collision\")",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "duplicate output timeseries"
    },
    {
      "id": "MQL-03-union-rejects-duplicate-scalar-labelsets",
      "query": "union(1, 2)",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "duplicate output timeseries"
    },
    {
      "id": "MQL-03-alias-requires-two-arguments",
      "query": "alias(oracle_keep_a)",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "invalid number of args for \"alias\"; got 1; want 2"
    },
    {
      "id": "MQL-03-alias-requires-a-string-name",
      "query": "alias(oracle_keep_a, 1)",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "arg #2 must be a string"
    },
    {
      "id": "MQL-03-empty-union-argument-is-invalid",
      "query": "(oracle_keep_a,,oracle_keep_b)",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "unexpected token \",\""
    },
    {
      "id": "MQL-03-uppercase-alias-function-name-is-unsupported",
      "query": "ALIAS(oracle_keep_a, \"oracle_alias\")",
      "evaluation_offset_ms": 30000,
      "status": 422,
      "error_type": "422",
      "error_contains": "unsupported function \"ALIAS\""
    }
  ],
  "error_cases": [
    {
      "id": "MQL-09-bare-i-is-not-a-duration",
      "params": {
        "query": "count_over_time(vector(time())[5i:i])",
        "start": "0",
        "end": "2",
        "step": "1s"
      },
      "status": 422,
      "error_type": "422",
      "error_contains": "cannot find WITH template for \"i\""
    }
  ]
}
