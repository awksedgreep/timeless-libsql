  "cases": [
    {
      "id": "MQL-09-direct-window-one-second-step",
      "query": "count_over_time(oracle_step[5i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 4000, "step": "1s"},
      "expected_metric": {"job": "oracle"},
      "expected_values": [5, 5, 5, 5, 5]
    },
    {
      "id": "MQL-09-direct-window-two-second-step",
      "query": "count_over_time(oracle_step[5i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 4000, "step": "2s"},
      "expected_metric": {"job": "oracle"},
      "expected_values": [10, 10, 10]
    },
    {
      "id": "MQL-09-subquery-window-and-resolution",
      "query": "max_over_time(vector(time())[5i:1i]) - min_over_time(vector(time())[5i:1i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 4000, "step": "2s"},
      "expected_values": [8, 8, 8]
    },
    {
      "id": "MQL-09-millisecond-step",
      "query": "max_over_time(vector(time())[5i:1i]) - min_over_time(vector(time())[5i:1i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 3000, "step": "1500ms"},
      "expected_values": [6, 6, 6]
    },
    {
      "id": "MQL-09-zero-step-relative-window",
      "query": "count_over_time(vector(time())[0i:1i])",
      "range": {"start_offset_ms": 0, "end_offset_ms": 2000, "step": "1s"},
      "expected_values": [1, 1, 1]
    }
  ],
  "operator_cases": [
    {
      "id": "MQL-01-default-fills-filtered-and-missing-grid-points",
