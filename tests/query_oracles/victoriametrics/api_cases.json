      "range": {"start_offset_ms": 10000, "end_offset_ms": 30000, "step": "10s"},
      "expected_results": [
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "a", "job": "oracle", "zone": "east"},
          "values": [0, 0, 3]
        },
        {
          "metric": {"__name__": "oracle_mql_cpu", "host": "b", "job": "oracle", "zone": "west"},
          "values": [0, 0, 4]
        }
      ]
    },
    {
      "id": "MQL-01-default-preserves-completely-filtered-series-identity",
