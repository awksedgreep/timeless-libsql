{
  "schema_version": 1,
  "oracle": "prometheus-v3.13.2",
  "lookback_cases": [
    {
      "id": "PQL-S16-open-lookback-boundary",
      "evaluation_offset_ms": 2000,
      "lookback_delta": "2s",
      "expected_result_count": 0
    },
    {
      "id": "PQL-S16-millisecond-lookback-inclusion",
      "evaluation_offset_ms": 2000,
      "lookback_delta": "2001ms",
      "expected_result_count": 1
    },
    {
      "id": "PQL-S16-zero-selects-default-lookback",
      "evaluation_offset_ms": 2000,
      "lookback_delta": "0",
      "expected_result_count": 1
    }
  ],
  "temporal_cases": [
    {
      "id": "PQL-S07-positive-offset",
      "query": "oracle_temporal offset 20s",
      "evaluation_offset_ms": 30000,
      "expected_values": [5]
    },
    {
      "id": "PQL-S07-negative-offset",
      "query": "oracle_temporal offset -20s",
      "evaluation_offset_ms": 0,
      "expected_values": [6]
    },
    {
      "id": "PQL-S08-numeric-at-before-offset",
      "query": "oracle_temporal @ {at} offset 10s",
      "at_offset_ms": 20000,
      "evaluation_offset_ms": 30000,
      "expected_values": [5]
    },
    {
      "id": "PQL-S07-range-offset-retains-outer-timestamps",
      "query": "oracle_temporal offset 10s",
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [3, 4, 5, 6]
    },
    {
      "id": "PQL-S08-range-at-start",
      "query": "oracle_temporal @ start()",
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [4, 4, 4, 4]
    },
    {
      "id": "PQL-S08-range-at-end",
      "query": "oracle_temporal @ end()",
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [7, 7, 7, 7]
    }
  ],
  "subquery_cases": [
    {
      "id": "PQL-S09-global-resolution-alignment",
      "query": "oracle_temporal[30s:10s]",
      "evaluation_offset_ms": 25000,
      "expected_matrix": [[0, 4], [10000, 5], [20000, 6]]
    },
    {
      "id": "PQL-S09-default-resolution",
      "query": "oracle_temporal[30s:]",
      "evaluation_offset_ms": 30000,
      "expected_matrix": [[15000, 5], [30000, 7]]
    },
    {
      "id": "PQL-S09-root-offset-shifts-output-grid",
      "query": "oracle_temporal[20s:10s] offset 10s",
      "evaluation_offset_ms": 30000,
      "expected_matrix": [[10000, 5], [20000, 6]]
    },
    {
      "id": "PQL-S09-root-at-uses-fixed-inner-grid",
      "query": "oracle_temporal[20s:10s] @ {at}",
      "at_offset_ms": 20000,
      "evaluation_offset_ms": 30000,
      "expected_matrix": [[10000, 5], [20000, 6]]
    },
    {
      "id": "PQL-S09-avg-over-subquery-open-left-window",
      "query": "avg_over_time(oracle_temporal[20s:10s])",
      "evaluation_offset_ms": 30000,
      "expected_values": [6.5]
    },
    {
      "id": "PQL-S09-range-evaluation-preserves-outer-grid",
      "query": "avg_over_time(oracle_temporal[20s:10s])",
      "evaluation_offset_ms": 0,
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [3.5, 4.5, 5.5, 6.5]
    },
    {
      "id": "PQL-S09-range-at-start-fixes-inner-grid",
      "query": "avg_over_time(oracle_temporal[20s:10s] @ start())",
      "evaluation_offset_ms": 0,
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [3.5, 3.5, 3.5, 3.5]
    },
    {
      "id": "PQL-S09-range-at-end-fixes-inner-grid",
      "query": "avg_over_time(oracle_temporal[20s:10s] @ end())",
      "evaluation_offset_ms": 0,
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [6.5, 6.5, 6.5, 6.5]
    },
    {
      "id": "PQL-S09-nested-subquery-root",
      "query": "avg_over_time(oracle_temporal[20s:10s])[20s:10s]",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_matrix": [[20000, 5.5], [30000, 6.5]]
    },
    {
      "id": "PQL-S09-nested-subquery-function",
      "query": "avg_over_time(avg_over_time(oracle_temporal[20s:10s])[20s:10s])",
      "evaluation_offset_ms": 30000,
      "expected_values": [6]
    }
  ],
  "operator_cases": [
    {
      "id": "PQL-O01-unary-vector-drops-name",
      "query": "-oracle_temporal",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [-7]
    },
    {
      "id": "PQL-O01-unary-vector-range-grid-drops-name",
      "query": "-oracle_temporal",
      "evaluation_offset_ms": 0,
      "drop_metric_name": true,
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [-4, -5, -6, -7]
    },
    {
      "id": "PQL-O01-unary-nested-range-function",
      "query": "-avg_over_time(oracle_temporal[20s])",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [-6.5]
    },
    {
      "id": "PQL-O01-unary-inside-subquery-function",
      "query": "avg_over_time((-oracle_temporal)[20s:10s])",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [-6.5]
    },
    {
      "id": "PQL-O01-double-unary-still-drops-name",
      "query": "-(-oracle_temporal)",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [7]
    },
    {
      "id": "PQL-O02-vector-plus-scalar",
      "query": "oracle_temporal + 2",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [9]
    },
    {
      "id": "PQL-O02-scalar-minus-vector",
      "query": "20 - oracle_temporal",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [13]
    },
    {
      "id": "PQL-O02-vector-multiply-scalar-range",
      "query": "oracle_temporal * 2",
      "evaluation_offset_ms": 0,
      "drop_metric_name": true,
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_values": [8, 10, 12, 14]
    },
    {
      "id": "PQL-O02-vector-divide-by-zero",
      "query": "oracle_temporal / 0",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": ["+Inf"]
    },
    {
      "id": "PQL-O02-vector-modulo",
      "query": "oracle_temporal % 4",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [3]
    },
    {
      "id": "PQL-O02-vector-power",
      "query": "oracle_temporal ^ 2",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [49]
    },
    {
      "id": "PQL-O05-default-one-to-one-excludes-name",
      "query": "oracle_temporal + oracle_temporal",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [14]
    },
    {
      "id": "PQL-O03-vector-scalar-filter-keeps-value-and-name",
      "query": "oracle_temporal > 5",
      "evaluation_offset_ms": 30000,
      "expected_values": [7]
    },
    {
      "id": "PQL-O03-vector-scalar-filter-drops-false",
      "query": "oracle_temporal < 5",
      "evaluation_offset_ms": 30000,
      "expected_empty": true
    },
    {
      "id": "PQL-O03-vector-scalar-bool-true-drops-name",
      "query": "oracle_temporal > bool 5",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [1]
    },
    {
      "id": "PQL-O03-vector-scalar-bool-false-drops-name",
      "query": "oracle_temporal < bool 5",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [0]
    },
    {
      "id": "PQL-O03-scalar-vector-filter-keeps-vector-value-and-name",
      "query": "5 < oracle_temporal",
      "evaluation_offset_ms": 30000,
      "expected_values": [7]
    },
    {
      "id": "PQL-O03-range-filter-is-sparse",
      "query": "oracle_temporal >= 6",
      "evaluation_offset_ms": 0,
      "range": {"start_offset_ms": 0, "end_offset_ms": 30000, "step": "10s"},
      "expected_offsets_ms": [20000, 30000],
      "expected_values": [6, 7]
    },
    {
      "id": "PQL-O03-vector-vector-filter-retains-lhs-name",
      "query": "oracle_temporal == oracle_temporal",
      "evaluation_offset_ms": 30000,
      "expected_values": [7]
    },
    {
      "id": "PQL-O03-vector-vector-bool-drops-name",
      "query": "oracle_temporal == bool oracle_temporal",
      "evaluation_offset_ms": 30000,
      "drop_metric_name": true,
      "expected_values": [1]
    },
    {
      "id": "PQL-O04-and-retains-left-value-name",
      "query": "oracle_temporal and oracle_lookback",
      "evaluation_offset_ms": 30000,
      "expected_values": [7]
    },
    {
      "id": "PQL-O04-unless-filters-matched-left",
      "query": "oracle_temporal unless oracle_lookback",
      "evaluation_offset_ms": 30000,
      "expected_empty": true
    },
    {
      "id": "PQL-O04-or-prefers-matched-left",
      "query": "oracle_temporal or oracle_lookback",
      "evaluation_offset_ms": 30000,
      "expected_values": [7]
    },
    {
      "id": "PQL-O06-on-keeps-only-matching-labels",
      "query": "oracle_matching_lhs + on(host) oracle_matching_rhs",
      "evaluation_offset_ms": 30000,
      "expected_metric": {"host": "a"},
      "expected_values": [10]
    },
    {
      "id": "PQL-O06-ignoring-removes-ignored-output-labels",
      "query": "oracle_matching_lhs + ignoring(zone) oracle_matching_rhs",
      "evaluation_offset_ms": 30000,
      "expected_metric": {"host": "a", "job": "oracle", "shared": "x"},
      "expected_values": [10]
    },
    {
      "id": "PQL-O06-comparison-on-drops-nonmatching-labels-and-name",
      "query": "oracle_matching_lhs == on(host) oracle_matching_lhs",
      "evaluation_offset_ms": 30000,
      "expected_metric": {"host": "a"},
      "expected_values": [8]
    },
    {
      "id": "PQL-O06-set-on-retains-complete-left-labelset",
      "query": "oracle_matching_lhs and on(host) oracle_matching_rhs",
      "evaluation_offset_ms": 30000,
      "expected_metric": {"__name__": "oracle_matching_lhs", "host": "a", "job": "oracle", "shared": "x", "zone": "east"},
      "expected_values": [8]
    },
    {
      "id": "PQL-O06-missing-on-label-matches-empty",
      "query": "oracle_matching_lhs + on(missing) oracle_matching_rhs",
      "evaluation_offset_ms": 30000,
      "expected_metric": {},
      "expected_values": [10]
    },
    {
      "id": "PQL-O06-empty-on-list-matches-empty",
      "query": "oracle_matching_lhs + on() oracle_matching_rhs",
      "evaluation_offset_ms": 30000,
      "expected_metric": {},
      "expected_values": [10]
    },
    {
      "id": "PQL-O07-group-left-copies-one-side-label",
      "query": "oracle_group_many_lhs + on(host) group_left(team) oracle_group_one_rhs",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {"metric": {"host": "a", "job": "oracle", "owner": "old", "pod": "p1", "team": "core", "zone": "east"}, "value": 10},
        {"metric": {"host": "a", "job": "oracle", "owner": "old", "pod": "p2", "team": "core", "zone": "west"}, "value": 11}
      ]
    },
    {
      "id": "PQL-O07-group-left-removes-absent-included-label",
      "query": "oracle_group_many_lhs + on(host) group_left(owner) oracle_group_one_rhs",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {"metric": {"host": "a", "job": "oracle", "pod": "p1", "zone": "east"}, "value": 10},
        {"metric": {"host": "a", "job": "oracle", "pod": "p2", "zone": "west"}, "value": 11}
      ]
    },
    {
      "id": "PQL-O07-group-right-preserves-operation-direction",
      "query": "oracle_group_one_lhs - on(host) group_right(team) oracle_group_many_rhs",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {"metric": {"host": "a", "job": "oracle", "pod": "p1", "team": "core", "zone": "east"}, "value": 6},
        {"metric": {"host": "a", "job": "oracle", "pod": "p2", "team": "core", "zone": "west"}, "value": 5}
      ]
    },
    {
      "id": "PQL-O07-group-right-comparison-keeps-right-name-left-value",
      "query": "oracle_group_one_lhs > on(host) group_right(team) oracle_group_many_rhs",
      "evaluation_offset_ms": 30000,
      "expected_results": [
        {"metric": {"__name__": "oracle_group_many_rhs", "host": "a", "job": "oracle", "pod": "p1", "team": "core", "zone": "east"}, "value": 8},
        {"metric": {"__name__": "oracle_group_many_rhs", "host": "a", "job": "oracle", "pod": "p2", "team": "core", "zone": "west"}, "value": 8}
      ]
    },
    {
      "id": "PQL-O09-sum-by",
      "query": "sum by (region) (oracle_aggregation)",
