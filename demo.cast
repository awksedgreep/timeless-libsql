[0.737, "o", ".print '-- each (name, labels) pair is its own series: the cardinality the engine has to index'\r\r\n\u001b[?2004l\r"]
[0.000, "o", "-- each (name, labels) pair is its own series: the cardinality the engine has to index\r\r\n"]
[0.000, "o", "\u001b[?2004h"]
[0.000, "o", "sqlite> "]
