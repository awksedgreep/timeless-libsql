[0.000, "o", "\u001b[?2004hsqlite> "]
[2.740, "o", ".print '-- bucket auth errors into 5-minute counts -- nobody told it when the incident was'\r\r\n\u001b[?2004l\r"]
[0.000, "o", "-- bucket auth errors into 5-minute counts -- nobody told it when the incident was\r\r\n"]
[0.000, "o", "\u001b[?2004hsqlite> "]
[9.882, "o", "SELECT strftime('%H:%M', bucket_ts/1000, 'unixepoch') AS bucket, n FROM timeless_log_buckets('logs','level','{\"s \rervice\":\"auth\",\"level\":\"error\"}',(SELECT min(min_ts) FROM timeless_series('metrics')),(SELECT max(max_ts) FROM timeless_ \rseries('metrics')), 300000);\r\r\n\u001b[?2004l\r"]
[0.591, "o", "╭────────┬───────╮\r\r\n│ bucket │   n   │\r\r\n╞════════╪═══════╡\r\r\n│ 21:52  │   790 │\r\r\n│ 21:57  │   831 │\r\r\n│ 22:02  │   811 │\r\r\n│ 22:07  │   846 │\r\r\n│ 22:12  │ 88022 │\r\r\n│ 22:17  │ 88845 │\r\r\n│ 22:22  │ 88424 │\r\r\n│ 22:27  │ 88181 │\r\r\n│ 22:32  │   880 │\r\r\n│ 22:37  │   795 │\r\r\n│ 22:42  │   848 │\r\r\n│ 22:47  │   763 │\r\r\n╰────────┴───────╯\r\r\nRun Time: real 0.591583 user 0.545828 sys 0.045270\r\r\n"]
[0.000, "o", "\u001b[?2004h"]
[0.000, "o", "sqlite> "]
[4.234, "o", ".print '-- indexed metadata columns read like an ordinary table'\r\r\n\u001b[?2004l\r"]
[0.000, "o", "-- indexed metadata columns read like an ordinary table\r\r\n"]
[0.000, "o", "\u001b[?2004hsqlite> "]
[5.468, "o", "SELECT datetime(ts/1000,'unixepoch') AS time, message FROM logs WHERE service='auth' AND level='error' ORDER BY  \rts DESC LIMIT 5;\r\r\n\u001b[?2004l\r"]
[0.015, "o", "╭─────────────────────┬────────────────────────────────────────────────────────╮\r\r\n│        time         │                        message                         │\r\r\n╞═════════════════════╪════════════════════════════════════════════════════════╡\r\r\n│ 2026-08-23 22:52:29 │ request 980091 failed: connect timeout to auth-backend │\r\r\n│ 2026-08-23 22:52:29 │ request 596896 failed: internal error (status 500)     │\r\r\n│ 2026-08-23 22:52:28 │ request 942889 failed: connect timeout to auth-backend │\r\r\n│ 2026-08-23 22:52:27 │ request 163894 failed: connect timeout to auth-backend │\r\r\n│ 2026-08-23 22:52:27 │ request 311657 failed: internal error (status 404)     │\r\r\n╰"]
