[0.000, "o", "\u001b[?2004hsqlite> "]
[3.740, "o", ".print '-- error logs carry the trace_id of the failed request, so logs and traces correlate'\r\r\n\u001b[?2004l\r"]
[0.000, "o", "-- error logs carry the trace_id of the failed request, so logs and traces correlate\r\r\n"]
[0.000, "o", "\u001b[?2004hsqlite> "]
[6.129, "o", "SELECT json_extract(metadata,'$.trace_id') AS trace_id FROM logs WHERE level='error' AND json_extract(metadata,' \r$.trace_id') IS NOT NULL LIMIT 3;\r\r\n\u001b[?2004l\r"]
