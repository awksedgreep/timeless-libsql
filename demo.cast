[0.000, "o", "\u001b[?2004hsqlite> "]
[3.739, "o", ".print '-- and the span attribute index we declared up front answers this one'\r\r\n\u001b[?2004l\r"]
[0.000, "o", "-- and the span attribute index we declared up front answers this one\r\r\n"]
[0.000, "o", "\u001b[?2004hsqlite> "]
[6.917, "o", "SELECT service, count(*) AS spans FROM spans WHERE attribute_filter='{\"scope\":\"span\",\"path\":\"/http.method\",\"valu \re\":\"GET\"}' GROUP BY service ORDER BY spans DESC LIMIT 4;\r\r\n\u001b[?2004l\r"]
[0.902, "o", "╭──────────┬───────╮\r\r\n│ service  │ spans │\r\r\n╞══════════╪═══════╡\r\r\n│ cache    │ 29188 │\r\r\n│ shipping │ 29100 │\r\r\n│ notify   │ 29078 │\r\r\n│ webhooks │ 29016 │\r\r\n╰──────────┴───────╯\r\r\nRun Time: real 0.901808 user 0.835576 sys 0.026804\r\r\n"]
