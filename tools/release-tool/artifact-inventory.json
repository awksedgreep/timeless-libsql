      "platform": "macos"
    }
  ],
  "fixed_files": [
    "install.sh",
    "uninstall.sh",
    "licenses/timeless-libsql-MIT.txt",
    "SBOM.spdx.json",
    "THIRD_PARTY_LICENSES.txt",
    "artifact-manifest.json",
    "SHA256SUMS"
